/target

# JetBrains IDE files
/.idea/

# Personal overrides, layered on top of the committed config/ baseline. May hold
# machine-specific paths or tokens, so it's not committed.
/lodestone.toml

# On-disk file store ([store]) and any test store dirs — runtime data, not source.
/.lodestone-store/
/.store-test/

# Memory/solution SQLite store ([memory]) — runtime data, never source.
/.lodestone-memory/

# Smoke-harness runtime artifacts — the harness creates these in smoke/<node>/.
# Only the configs (and the harness script itself) are committed.
/smoke/*/.lodestone-memory/
/smoke/*/.lodestone-store/
/smoke/*/*.log

# Claude Code session state.
/.claude/
